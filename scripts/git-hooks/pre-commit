#!/bin/sh
# src/의 ES 모듈을 script.js로 번들링하고, script.js / style.css의 캐시 버스팅 버전(?v=)을
# 커밋 직전에 자동 갱신한다.
# 설치: cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

node scripts/build.js || exit 1
node scripts/bump-cache-version.js

if ! git diff --quiet -- script.js index.html; then
  git add script.js index.html
fi
